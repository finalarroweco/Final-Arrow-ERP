generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  TENANT
  COMPANY
  BRANCH
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum LeadStage {
  NEW
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  PURCHASE_RECEIPT
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  companies   Company[]
  memberships Membership[]
  roles       Role[]
  auditLogs   AuditLog[]
  invitations Invitation[]
}

model Company {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name           String
  legalName      String?
  code           String
  baseCurrency   String          @default("OMR") @db.VarChar(3)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branches       Branch[]
  departments    Department[]
  scopes         AccessScope[]
  invitations    Invitation[]
  customers      Customer[]
  leads          Lead[]
  quotes         Quote[]
  orders         SalesOrder[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  inventoryItems InventoryItem[]
  stockBalances  StockBalance[]
  receipts       GoodsReceipt[]
  invoices       Invoice[]
  projects       Project[]
  employees      Employee[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Branch {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  companyId      String          @db.Uuid
  company        Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  name           String
  code           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  departments    Department[]
  scopes         AccessScope[]
  invitations    Invitation[]
  customers      Customer[]
  leads          Lead[]
  quotes         Quote[]
  orders         SalesOrder[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  inventoryItems InventoryItem[]
  stockBalances  StockBalance[]
  receipts       GoodsReceipt[]
  invoices       Invoice[]
  projects       Project[]
  employees      Employee[]

  @@unique([companyId, code])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId])
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  companyId String   @db.Uuid
  branchId  String?  @db.Uuid
  company   Company  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch    Branch?  @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  name      String
  createdAt DateTime @default(now())

  @@index([tenantId, companyId, branchId])
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Membership {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  userId     String           @db.Uuid
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status     MembershipStatus @default(INVITED)
  createdAt  DateTime         @default(now())
  roleGrants RoleGrant[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  grants      RoleGrant[]
  permissions RolePermission[]
  invitations Invitation[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

model Permission {
  key   String           @id
  roles RolePermission[]
}

model RolePermission {
  tenantId      String     @db.Uuid
  roleId        String     @db.Uuid
  permissionKey String
  role          Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([tenantId, roleId, permissionKey])
}

model RoleGrant {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  membershipId String        @db.Uuid
  roleId       String        @db.Uuid
  membership   Membership    @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role         Role          @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  scopes       AccessScope[]

  @@unique([tenantId, id])
  @@index([tenantId, membershipId])
}

model AccessScope {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  grantId   String    @db.Uuid
  type      ScopeType
  companyId String?   @db.Uuid
  branchId  String?   @db.Uuid
  grant     RoleGrant @relation(fields: [tenantId, grantId], references: [tenantId, id], onDelete: Cascade)
  company   Company?  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch    Branch?   @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)

  @@index([tenantId, grantId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  email      String
  tokenHash  String    @unique
  roleId     String    @db.Uuid
  type       ScopeType
  companyId  String?   @db.Uuid
  branchId   String?   @db.Uuid
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role      @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  company    Company?  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch?   @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)

  @@index([tenantId, email])
  @@index([expiresAt])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  companyId      String       @db.Uuid
  branchId       String?      @db.Uuid
  code           String
  displayName    String
  legalName      String?
  email          String?
  phone          String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String       @db.Uuid
  company        Company      @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  convertedLeads Lead[]
  quotes         Quote[]
  orders         SalesOrder[]
  invoices       Invoice[]

  @@unique([companyId, code])
  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, displayName])
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  companyId      String          @db.Uuid
  branchId       String?         @db.Uuid
  code           String
  displayName    String
  legalName      String?
  email          String?
  phone          String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String          @db.Uuid
  company        Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch         Branch?         @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, code])
  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, displayName])
}

model InventoryItem {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  companyId    String             @db.Uuid
  branchId     String?            @db.Uuid
  sku          String
  name         String
  unit         String             @db.VarChar(16)
  description  String?
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    String             @db.Uuid
  company      Company            @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch       Branch?            @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  balances     StockBalance[]
  receiptLines GoodsReceiptLine[]

  @@unique([companyId, sku])
  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, name])
}

model StockBalance {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  companyId String          @db.Uuid
  branchId  String          @db.Uuid
  itemId    String          @db.Uuid
  quantity  Decimal         @default(0) @db.Decimal(18, 3)
  updatedAt DateTime        @updatedAt
  company   Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch    Branch          @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  item      InventoryItem   @relation(fields: [tenantId, companyId, itemId], references: [tenantId, companyId, id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, branchId, itemId])
  @@index([tenantId, companyId, branchId])
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  balanceId     String            @db.Uuid
  type          StockMovementType
  delta         Decimal           @db.Decimal(18, 3)
  reason        String
  actorId       String            @db.Uuid
  createdAt     DateTime          @default(now())
  balance       StockBalance      @relation(fields: [tenantId, balanceId], references: [tenantId, id], onDelete: Restrict)
  receiptLineId String?           @unique @db.Uuid
  receiptLine   GoodsReceiptLine? @relation(fields: [tenantId, receiptLineId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, receiptLineId])
  @@index([tenantId, balanceId, createdAt])
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  companyId    String              @db.Uuid
  branchId     String?             @db.Uuid
  supplierId   String              @db.Uuid
  number       String
  supplierName String
  currency     String              @db.VarChar(3)
  subtotal     Decimal             @db.Decimal(18, 3)
  notes        String?
  status       PurchaseOrderStatus @default(DRAFT)
  issuedAt     DateTime?
  receivedAt   DateTime?
  cancelledAt  DateTime?
  createdBy    String              @db.Uuid
  createdAt    DateTime            @default(now())
  company      Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch       Branch?             @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  supplier     Supplier            @relation(fields: [tenantId, companyId, supplierId], references: [tenantId, companyId, id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  receipt      GoodsReceipt?

  @@unique([companyId, number])
  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, branchId, createdAt])
}

model PurchaseOrderLine {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  orderId      String             @db.Uuid
  position     Int
  description  String
  quantity     Int
  unitPrice    Decimal            @db.Decimal(18, 3)
  amount       Decimal            @db.Decimal(18, 3)
  order        PurchaseOrder      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  receiptLines GoodsReceiptLine[]

  @@unique([orderId, position])
  @@unique([tenantId, orderId, id])
  @@index([tenantId, orderId])
}

model GoodsReceipt {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  companyId String             @db.Uuid
  branchId  String             @db.Uuid
  orderId   String             @unique @db.Uuid
  createdBy String             @db.Uuid
  createdAt DateTime           @default(now())
  company   Company            @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch    Branch             @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  order     PurchaseOrder      @relation(fields: [tenantId, companyId, orderId], references: [tenantId, companyId, id], onDelete: Restrict)
  lines     GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, orderId])
  @@unique([tenantId, companyId, orderId, id])
  @@index([tenantId, companyId, branchId, createdAt])
}

model GoodsReceiptLine {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  companyId   String            @db.Uuid
  orderId     String            @db.Uuid
  receiptId   String            @db.Uuid
  orderLineId String            @db.Uuid
  itemId      String            @db.Uuid
  quantity    Decimal           @db.Decimal(18, 3)
  receipt     GoodsReceipt      @relation(fields: [tenantId, companyId, orderId, receiptId], references: [tenantId, companyId, orderId, id], onDelete: Restrict)
  orderLine   PurchaseOrderLine @relation(fields: [tenantId, orderId, orderLineId], references: [tenantId, orderId, id], onDelete: Restrict)
  item        InventoryItem     @relation(fields: [tenantId, companyId, itemId], references: [tenantId, companyId, id], onDelete: Restrict)
  movement    StockMovement?

  @@unique([tenantId, id])
  @@unique([receiptId, orderLineId])
  @@index([tenantId, companyId, orderId])
}

model Lead {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  companyId           String    @db.Uuid
  branchId            String?   @db.Uuid
  code                String
  displayName         String
  email               String?
  phone               String?
  notes               String?
  stage               LeadStage @default(NEW)
  convertedCustomerId String?   @db.Uuid
  convertedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String    @db.Uuid
  company             Company   @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch              Branch?   @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  convertedCustomer   Customer? @relation(fields: [tenantId, companyId, convertedCustomerId], references: [tenantId, companyId, id], onDelete: Restrict)

  @@unique([companyId, code])
  @@unique([tenantId, id])
  @@index([tenantId, companyId, branchId, stage])
}

model Quote {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  companyId  String      @db.Uuid
  branchId   String?     @db.Uuid
  customerId String      @db.Uuid
  number     String
  status     QuoteStatus @default(DRAFT)
  sentAt     DateTime?
  decidedAt  DateTime?
  currency   String      @db.VarChar(3)
  subtotal   Decimal     @db.Decimal(18, 3)
  notes      String?
  createdBy  String      @db.Uuid
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  company    Company     @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  customer   Customer    @relation(fields: [tenantId, companyId, customerId], references: [tenantId, companyId, id], onDelete: Restrict)
  lines      QuoteLine[]
  order      SalesOrder?

  @@unique([companyId, number])
  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, branchId, createdAt])
}

model QuoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  quoteId     String  @db.Uuid
  position    Int
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(18, 3)
  amount      Decimal @db.Decimal(18, 3)
  quote       Quote   @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade)

  @@unique([quoteId, position])
  @@index([tenantId, quoteId])
}

model SalesOrder {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  companyId    String           @db.Uuid
  branchId     String?          @db.Uuid
  customerId   String           @db.Uuid
  quoteId      String           @unique @db.Uuid
  number       String
  customerName String
  currency     String           @db.VarChar(3)
  subtotal     Decimal          @db.Decimal(18, 3)
  notes        String?
  status       SalesOrderStatus @default(NEW)
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdBy    String           @db.Uuid
  createdAt    DateTime         @default(now())
  company      Company          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch       Branch?          @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  customer     Customer         @relation(fields: [tenantId, companyId, customerId], references: [tenantId, companyId, id], onDelete: Restrict)
  quote        Quote            @relation(fields: [tenantId, companyId, quoteId], references: [tenantId, companyId, id], onDelete: Restrict)
  lines        SalesOrderLine[]
  invoice      Invoice?

  @@unique([companyId, number])
  @@unique([tenantId, companyId, quoteId])
  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, branchId, createdAt])
}

model SalesOrderLine {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  orderId     String     @db.Uuid
  position    Int
  description String
  quantity    Int
  unitPrice   Decimal    @db.Decimal(18, 3)
  amount      Decimal    @db.Decimal(18, 3)
  order       SalesOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@unique([orderId, position])
  @@index([tenantId, orderId])
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  companyId    String        @db.Uuid
  branchId     String?       @db.Uuid
  customerId   String        @db.Uuid
  orderId      String        @unique @db.Uuid
  number       String
  customerName String
  currency     String        @db.VarChar(3)
  subtotal     Decimal       @db.Decimal(18, 3)
  notes        String?
  status       InvoiceStatus @default(DRAFT)
  issuedAt     DateTime?
  voidedAt     DateTime?
  voidReason   String?
  createdBy    String        @db.Uuid
  createdAt    DateTime      @default(now())
  company      Company       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  customer     Customer      @relation(fields: [tenantId, companyId, customerId], references: [tenantId, companyId, id], onDelete: Restrict)
  order        SalesOrder    @relation(fields: [tenantId, companyId, orderId], references: [tenantId, companyId, id], onDelete: Restrict)
  lines        InvoiceLine[]

  @@unique([companyId, number])
  @@unique([tenantId, companyId, orderId])
  @@unique([tenantId, id])
  @@index([tenantId, companyId, branchId, createdAt])
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  invoiceId   String  @db.Uuid
  position    Int
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(18, 3)
  amount      Decimal @db.Decimal(18, 3)
  invoice     Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([invoiceId, position])
  @@index([tenantId, invoiceId])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  companyId   String        @db.Uuid
  branchId    String?       @db.Uuid
  code        String
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  dueDate     DateTime?     @db.Date
  createdBy   String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch      Branch?       @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)
  tasks       ProjectTask[]

  @@unique([companyId, code])
  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, branchId, status])
}

model ProjectTask {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  companyId   String            @db.Uuid
  projectId   String            @db.Uuid
  title       String
  description String?
  status      ProjectTaskStatus @default(TODO)
  dueDate     DateTime?         @db.Date
  completedAt DateTime?
  createdBy   String            @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [tenantId, companyId, projectId], references: [tenantId, companyId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, companyId, projectId, status])
}

model Employee {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  companyId String         @db.Uuid
  branchId  String?        @db.Uuid
  code      String
  fullName  String
  jobTitle  String?
  email     String?
  phone     String?
  startDate DateTime?      @db.Date
  status    EmployeeStatus @default(ACTIVE)
  createdBy String         @db.Uuid
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch    Branch?        @relation(fields: [tenantId, companyId, branchId], references: [tenantId, companyId, id], onDelete: Restrict)

  @@unique([companyId, code])
  @@unique([tenantId, id])
  @@index([tenantId, companyId, branchId, status])
}
