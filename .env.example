# Application connection (use a pooled URL for cloud hosting).
DATABASE_URL="postgresql://erp:erp@localhost:5432/final_arrow_erp?schema=public"
# Direct connection used by Prisma migrations. Same URL is fine for local PostgreSQL.
DIRECT_DATABASE_URL="postgresql://erp:erp@localhost:5432/final_arrow_erp?schema=public"
# Keep registration closed on hosted environments. Enable only for initial private setup.
ALLOW_REGISTRATION="false"
